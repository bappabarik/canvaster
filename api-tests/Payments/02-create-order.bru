meta {
  name: 02 Create Razorpay Order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/payments/create-order
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "tier_id": 1,
    "project_id": {{projectId}}
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setEnvVar("razorpayOrderId", res.body.data.razorpay_order_id);
  }
}